# --- MongoDB Atlas (rellena con tus datos, usa una contraseña nueva) ---
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/
MONGODB_DB=TouhouBD

# --- Seguridad (deben ser los mismos para frontend y backend; ya van generados) ---
API_KEY=cambia_esto
SESSION_SECRET=cambia_esto

# --- Administrador creado por scripts/seed.php ---
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esto

# --- Configuración de expiración del carrito (en minutos) ---
CART_TTL_MINUTES=30