<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Tienda de la Mansión Escarlata</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;700&family=Lora:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<header class="site-header">
  <a class="brand" href="/"><span class="brand-kanji">紅魔館</span> Mansión Escarlata</a>
  <nav>
    <% if (user && user.role === 'administrador') { %>
      <a href="/admin">Inventario</a>
    <% } else if (user) { %>
      <a href="/shop">Tienda</a>
    <% } %>
  </nav>
  <div class="session">
    <% if (user) { %>
      <span class="who"><%= user.username %></span>
      <a href="/logout">Salir</a>
    <% } else { %>
      <a href="/login">Entrar</a>
      <a href="/register">Registrarse</a>
    <% } %>
  </div>
</header>
<main class="container">
<% if (flash) { %><div class="alert alert-<%= flash.type %>"><%= flash.msg %></div><% } %>
